{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dissect.local/review-context.schema.json",
  "title": "Dissect review context",
  "type": "object",
  "required": ["schema_version", "mode", "scope", "intent", "repository", "behavioural_units", "candidates", "test_evidence", "complexity", "commands", "coverage", "limitations"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "mode": {"enum": ["diff", "full"]},
    "scope": {"type": "object"},
    "intent": {"$ref": "#/$defs/intent"},
    "repository": {"type": "object"},
    "behavioural_units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "test_evidence": {
      "type": "object",
      "required": ["status", "state", "artifacts", "subjects", "relations", "changes", "static_candidates", "matrix", "mutations", "proof_tests"],
      "properties": {
        "status": {"enum": ["complete", "partial", "not_applicable", "planned", "unavailable", "failed"]},
        "state": {"enum": ["Finding", "Checked", "Not applicable", "Not verified"]},
        "artifacts": {"type": "array", "items": {"type": "object"}},
        "subjects": {"type": "array", "items": {"type": "object"}},
        "relations": {"type": "array", "items": {"type": "object"}},
        "changes": {"type": "array", "items": {"type": "object"}},
        "static_candidates": {"type": "array", "items": {"type": "object"}},
        "matrix": {"type": "array", "items": {"$ref": "#/$defs/matrix_scenario"}},
        "mutations": {"type": "array", "items": {"type": "object"}},
        "targeted_mutation": {"type": "object"},
        "proof_tests": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "complexity": {"$ref": "#/$defs/complexity"},
    "commands": {"type": "array", "items": {"type": "object"}},
    "coverage": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/coverage_record"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "intent": {
      "type": "object",
      "required": ["sources", "summary", "constraints", "negative_requirements", "ambiguities"],
      "properties": {
        "sources": {"type": "array", "items": {"type": "object"}},
        "summary": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "negative_requirements": {"type": "array", "items": {"type": "string"}},
        "ambiguities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "kind", "entry_points", "changed_symbols", "inputs", "outputs", "state_read", "state_modified", "external_side_effects", "error_paths", "callers", "downstream_consumers", "configuration", "tests", "before", "after"],
      "properties": {
        "id": {"type": "string"}, "kind": {"type": "string"},
        "entry_points": {"type": "array", "items": {"type": "string"}},
        "changed_symbols": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "state_read": {"type": "array", "items": {"type": "string"}},
        "state_modified": {"type": "array", "items": {"type": "string"}},
        "external_side_effects": {"type": "array", "items": {"type": "string"}},
        "error_paths": {"type": "array", "items": {"type": "string"}},
        "callers": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "downstream_consumers": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "configuration": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}},
        "before": {"type": "string"}, "after": {"type": "string"}
      }
    },
    "reference": {
      "type": "object",
      "required": ["path", "symbols", "reason"],
      "properties": {
        "path": {"type": "string"},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": ["id", "source", "claim", "contract", "trigger_path", "impact", "supporting_evidence", "contradicting_evidence", "verification_attempts", "falsification_attempts", "status"],
      "properties": {
        "id": {"type": "string"}, "source": {"type": "string"}, "claim": {"type": "string"}, "contract": {"type": "string"},
        "trigger_path": {"type": "array", "items": {"type": "string"}}, "impact": {"type": "string"},
        "supporting_evidence": {"type": "array", "items": {"type": "object"}}, "contradicting_evidence": {"type": "array", "items": {"type": "object"}},
        "verification_attempts": {"type": "array", "items": {"type": "object"}}, "falsification_attempts": {"type": "array", "items": {"type": "object"}},
        "status": {"enum": ["candidate", "verified", "disproved", "not_verifiable", "duplicate"]}
      }
    },
    "complexity": {
      "type": "object",
      "required": ["status", "backend_id", "functions", "candidates", "policy"],
      "properties": {
        "status": {"enum": ["complete", "partial", "not_applicable", "unavailable", "failed"]},
        "backend_id": {"type": "string"},
        "applicable_files": {"type": "integer", "minimum": 0},
        "checked_files": {"type": "integer", "minimum": 0},
        "skipped_files": {"type": "integer", "minimum": 0},
        "reason_code": {"type": ["string", "null"]},
        "functions": {"type": "array", "items": {"$ref": "#/$defs/complexity_function"}},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/complexity_candidate"}},
        "policy": {"type": "object"}
      },
      "additionalProperties": true
    },
    "complexity_function": {
      "type": "object",
      "required": ["qualified_name", "logical_path", "source_layer", "content_sha256", "start_line", "end_line", "cyclomatic", "nloc", "token_count", "parameter_count", "is_test", "threshold", "threshold_source"],
      "properties": {
        "qualified_name": {"type": "string"}, "logical_path": {"type": "string"},
        "source_layer": {"type": "string"}, "content_sha256": {"$ref": "#/$defs/hash"},
        "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
        "cyclomatic": {"type": "integer", "minimum": 1}, "nloc": {"type": "integer", "minimum": 0},
        "token_count": {"type": "integer", "minimum": 0}, "parameter_count": {"type": "integer", "minimum": 0},
        "is_test": {"type": "boolean"},
        "threshold": {"type": ["integer", "null"], "minimum": 1},
        "threshold_source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "complexity_candidate": {
      "type": "object",
      "required": ["candidate_id", "function", "reason_code", "threshold", "threshold_source", "head_complexity"],
      "properties": {
        "candidate_id": {"type": "string"}, "function": {"$ref": "#/$defs/complexity_function"},
        "reason_code": {"type": "string"}, "threshold": {"type": "integer", "minimum": 1},
        "threshold_source": {"type": "string"}, "base_complexity": {"type": ["integer", "null"]},
        "head_complexity": {"type": "integer", "minimum": 1}, "delta": {"type": ["integer", "null"]},
        "changed_lines": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      },
      "additionalProperties": true
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_scenario": {
      "type": "object",
      "required": ["scenario_id", "production_state", "test_state", "source_hashes", "selected_tests", "result"],
      "properties": {
        "scenario_id": {"enum": ["base-code-base-tests", "base-code-head-tests", "head-code-base-tests", "head-code-head-tests"]},
        "production_state": {"enum": ["base", "head"]},
        "test_state": {"enum": ["base", "head"]},
        "source_hashes": {"type": "object"},
        "selected_tests": {"type": "array", "items": {"type": "string"}},
        "result": {"type": "object"}
      },
      "additionalProperties": true
    },
    "coverage_record": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["Finding", "Checked", "Not applicable", "Not verified"]},
        "reason": {"type": "string"},
        "backends": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/backend_record"}
        }
      },
      "additionalProperties": true
    },
    "backend_record": {
      "type": "object",
      "required": ["state", "level", "languages", "applicable_files", "checked_files", "skipped_files", "reason"],
      "properties": {
        "state": {"enum": ["Finding", "Checked", "Not applicable", "Not verified"]},
        "level": {"const": "structural"},
        "languages": {"type": "array", "items": {"type": "string"}},
        "applicable_files": {"type": "integer", "minimum": 0},
        "checked_files": {"type": "integer", "minimum": 0},
        "skipped_files": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "status": {"enum": ["complete", "not_applicable", "partial", "planned", "unavailable", "failed"]}
      },
      "additionalProperties": true
    }
  }
}
