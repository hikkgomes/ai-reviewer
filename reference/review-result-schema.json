{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dissect.local/review-result.schema.json",
  "type": "object",
  "required": ["schema_version", "mode", "findings", "open_questions", "not_verified", "coverage", "provenance", "candidates", "ledger"],
  "properties": {
    "schema_version": {"const": "1.0"}, "mode": {"enum": ["diff", "full"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "not_verified": {"type": "array", "items": {"type": "string"}},
    "coverage": {"type": "object"}
    ,"provenance": {
      "type": "object",
      "required": ["generator", "skill_path", "skill_sha256", "installed_skill_tree_sha256", "installed_skill_manifest", "invocation", "context_path", "raw_output_path", "final_output_path", "reviewer_source_commit", "reviewer_source_dirty", "benchmark_id", "benchmark_manifest_sha256", "benchmark_fixture_sha256", "intent_sha256", "codex_executable", "codex_version", "started_at", "completed_at"]
    }
    ,"candidates": {"type": "array", "items": {"type": "object"}}
    ,"ledger": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "candidate_id", "severity", "confidence", "location", "contract", "trigger_path", "impact", "evidence", "fix", "verification"],
      "properties": {
        "id": {"type": "string"}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "confidence": {"type": "string"},
        "location": {"type": "string"}, "contract": {"type": "string"}, "trigger_path": {"type": "string"}, "impact": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}, "fix": {"type": "string"}, "verification": {"type": "string"}
      }
    }
  }
}
