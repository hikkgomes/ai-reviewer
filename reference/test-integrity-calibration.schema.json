{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dissect.local/test-integrity-calibration.schema.json",
  "type": "object",
  "required": ["schema_version", "sample_source", "sample_id", "rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_source": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "rules": {"type": "object", "additionalProperties": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["reviewed_cases", "true_positive", "false_positive", "true_negative", "false_negative", "precision", "decisions"],
      "properties": {
        "reviewed_cases": {"type": "integer", "minimum": 1},
        "true_positive": {"type": "integer", "minimum": 3},
        "false_positive": {"type": "integer", "minimum": 0},
        "true_negative": {"type": "integer", "minimum": 8},
        "false_negative": {"type": "integer", "minimum": 0},
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case_id", "classification"]}}
      }
    }
  }
}
