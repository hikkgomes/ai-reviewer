{
  "schema_version": "1.0",
  "family": "GOV-TESTS",
  "default_enabled": [
    "GOV-TESTS-001",
    "GOV-TESTS-002",
    "GOV-TESTS-003",
    "GOV-TESTS-004",
    "GOV-TESTS-005",
    "GOV-TESTS-006",
    "GOV-TESTS-010"
  ],
  "rules": {
    "GOV-TESTS-001": {
      "failure_model": "A changed test or test command is disabled or made non-blocking.",
      "positive_cases": ["pytest.mark.skip", "continue-on-error: true", "test || true"],
      "negative_cases": ["test()", "pytest.raises", "property test", "compile test", "external boundary mock", "documented quarantine", "normal CI step", "supported parameter removal"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": true,
      "evidence": {
        "malformed": {"present": true, "cases": ["malformed test file is recorded as incomplete"]},
        "generated": {"present": true, "cases": ["generated test output is excluded by explicit path policy"]},
        "framework": {"present": true, "cases": ["pytest", "CI workflow"]},
        "suppression": {"present": true, "cases": ["documented quarantine with replacement guard"]},
        "locations": {"present": true, "cases": ["one exact line per disabled marker"]},
        "acceptance_review": {"reviewed": true, "sample_id": "test-integrity-rule-acceptance-v1"}
      }
    },
    "GOV-TESTS-002": {
      "failure_model": "A changed assertion or expected exception accepts a broader result.",
      "positive_cases": ["assert x", "toBeTruthy", "raises(Exception)"],
      "negative_cases": ["exact equality", "specific exception", "tolerance unchanged", "independent snapshot", "contract change", "property assertion", "compile assertion", "negative authorisation assertion"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": true,
      "evidence": {
        "malformed": {"present": true, "cases": ["malformed assertion file is incomplete"]},
        "generated": {"present": true, "cases": ["generated tests are not accepted as behavioural proof"]},
        "framework": {"present": true, "cases": ["pytest", "Jest matcher"]},
        "suppression": {"present": true, "cases": ["explicit contract-change evidence"]},
        "locations": {"present": true, "cases": ["changed matcher location"]},
        "acceptance_review": {"reviewed": true, "sample_id": "test-integrity-rule-acceptance-v1"}
      }
    },
    "GOV-TESTS-003": {
      "failure_model": "The expected value is generated by the same implementation as the actual value.",
      "positive_cases": ["assert load() == load()", "expect(read()).toEqual(read())", "expected = serializer(value)", "assert source text from inspect.getsource"],
      "negative_cases": ["independent literal", "independent fixture", "round-trip property", "public contract", "golden file", "schema example", "different parser", "different implementation"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": true,
      "evidence": {
        "malformed": {"present": true, "cases": ["malformed oracle fixture"]},
        "generated": {"present": true, "cases": ["regenerated golden file is not independent"]},
        "framework": {"present": true, "cases": ["pytest", "Jest"]},
        "suppression": {"present": true, "cases": ["intended round-trip property"]},
        "locations": {"present": true, "cases": ["symmetric call location"]},
        "acceptance_review": {"reviewed": true, "sample_id": "test-integrity-rule-acceptance-v1"}
      }
    },
    "GOV-TESTS-004": {
      "failure_model": "A test double replaces the focal subject claimed by the test.",
      "positive_cases": ["patch(service.load)", "spyOn(service, 'load')", "stub(load)"],
      "negative_cases": ["mock HTTP client", "mock database boundary", "dependency injection", "fake clock", "fixture factory", "test helper", "mock logger", "mock external queue"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": true,
      "evidence": {
        "malformed": {"present": true, "cases": ["malformed mock fixture"]},
        "generated": {"present": true, "cases": ["generated mock setup is not proof"]},
        "framework": {"present": true, "cases": ["unittest.mock", "Jest", "Sinon"]},
        "suppression": {"present": true, "cases": ["external boundary doubles"]},
        "locations": {"present": true, "cases": ["patch call location"]},
        "acceptance_review": {"reviewed": true, "sample_id": "test-integrity-rule-acceptance-v1"}
      }
    },
    "GOV-TESTS-005": {
      "failure_model": "A test cannot fail because its observable check is tautological or all errors are swallowed.",
      "positive_cases": ["assert True", "assert value == value", "except BaseException: pass"],
      "negative_cases": ["property test", "compile test", "snapshot test", "expected exception", "subprocess exit check", "fixture helper", "assert response", "async assertion"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": true,
      "evidence": {
        "malformed": {"present": true, "cases": ["malformed test body"]},
        "generated": {"present": true, "cases": ["generated compile tests are retained"]},
        "framework": {"present": true, "cases": ["pytest", "subprocess", "property-based"]},
        "suppression": {"present": true, "cases": ["valid no-assertion compile test"]},
        "locations": {"present": true, "cases": ["tautological expression location"]},
        "acceptance_review": {"reviewed": true, "sample_id": "test-integrity-rule-acceptance-v1"}
      }
    },
    "GOV-TESTS-006": {
      "failure_model": "Production behaviour changes only for a test runtime or mock seam.",
      "positive_cases": ["types.FunctionType", "if TESTING", "unittest.mock"],
      "negative_cases": ["dependency injection", "clock injection", "interface substitution", "normal environment config", "Rust cfg(test)", "test build module", "public extension point", "production adapter"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": true,
      "evidence": {
        "malformed": {"present": true, "cases": ["malformed production module"]},
        "generated": {"present": true, "cases": ["generated test adapter excluded"]},
        "framework": {"present": true, "cases": ["Python unittest.mock", "Jest runtime marker"]},
        "suppression": {"present": true, "cases": ["normal dependency injection"]},
        "locations": {"present": true, "cases": ["runtime seam branch location"]},
        "acceptance_review": {"reviewed": true, "sample_id": "test-integrity-rule-acceptance-v1"}
      }
    },
    "GOV-TESTS-007": {
      "failure_model": "A parser-only or compiler-invalid fixture is used as behavioural proof.",
      "positive_cases": ["undefined placeholder type", "invalid signature", "parser-only match"],
      "negative_cases": ["valid Go project", "valid Rust project", "valid C project", "valid C++ project", "valid Java project", "valid C# project", "valid Python fixture", "valid TypeScript fixture"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": false,
      "evidence": {
        "malformed": {"present": true},
        "generated": {"present": true},
        "framework": {"present": true},
        "suppression": {"present": true},
        "locations": {"present": true},
        "acceptance_review": {"reviewed": false}
      }
    },
    "GOV-TESTS-008": {
      "failure_model": "Dynamic evidence shows that a claimed focal subject is not reached.",
      "positive_cases": [],
      "negative_cases": [],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": false
    },
    "GOV-TESTS-009": {
      "failure_model": "Repeated identical approved runs produce inconsistent outcomes.",
      "positive_cases": [],
      "negative_cases": [],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": false
    },
    "GOV-TESTS-010": {
      "failure_model": "A new test file or test-only helper/fixture is added without explicit creation approval.",
      "positive_cases": ["new test file without intent approval", "new integration test without approval", "new fixture without approved path"],
      "negative_cases": ["existing test file changed", "explicit create-test request", "approved path pattern", "generic implement request", "generic fix request", "generic test request", "generic verify request", "new production source"],
      "valid_fixture": true,
      "exact_locations": true,
      "negative_control": true,
      "acceptance_sample": true,
      "evidence": {
        "malformed": {"present": true, "cases": ["missing base snapshot remains unverified"]},
        "generated": {"present": true, "cases": ["generated paths are excluded by explicit path policy"]},
        "framework": {"present": true, "cases": ["unit, integration, end-to-end, and spec naming"]},
        "suppression": {"present": true, "cases": ["explicit request and approved path pattern"]},
        "locations": {"present": true, "cases": ["new file location is line 1"]},
        "acceptance_review": {"reviewed": true, "sample_id": "test-integrity-rule-acceptance-v1"}
      }
    }
  }
}
